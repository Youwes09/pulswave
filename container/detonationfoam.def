Bootstrap: localimage
From: openfoam8-base.sif

%environment
    export HOME=/opt
    unset LOGNAME
    unset USER
    export DEBIAN_FRONTEND=noninteractive
    source /opt/OpenFOAM/OpenFOAM-8/etc/bashrc
    export PATH=/opt/detonationFoam/bin:$PATH

%post
    export HOME=/opt
    unset LOGNAME
    unset USER
    git clone https://github.com/JieSun-pku/detonationFoam.git /opt/detonationFoam
    bash -c "export HOME=/opt && unset LOGNAME && unset USER && \
        source /opt/OpenFOAM/OpenFOAM-8/etc/bashrc && \
        cd /opt/detonationFoam && git checkout 02ed90db0a172f5abb7407347d4205f39274f144 && \
        cd detonationFoam_dev/ROUNDSchemes && chmod +x Allwmake && ./Allwmake && \
        cd ../fluxSchemes_improved && wmake && \
        cd ../dynamicMesh2D/dynamicMesh && wclean && wmake libso && \
        cd ../dynamicFvMesh && wclean && wmake libso && \
        cd ../.. && wmake"

%runscript
    export HOME=/opt
    unset LOGNAME
    unset USER
    source /opt/OpenFOAM/OpenFOAM-8/etc/bashrc
    exec "$@"
