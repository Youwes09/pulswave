FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}

dimensions      [0 0 0 1 0 0 0];
internalField   uniform 697.0;

boundaryField
{
    inflow
    {
        type            fixedValue;
        value           uniform 697.0;
    }
    outflow
    {
        type            zeroGradient;
    }
    upperBoundary
    {
        type            zeroGradient;
    }
    lowerWall
    {
        // slip-reflecting per paper Sec 2.2 -- no wall heat flux term
        type            zeroGradient;
    }
    jet
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
