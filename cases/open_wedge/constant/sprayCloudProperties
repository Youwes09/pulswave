FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      sprayCloudProperties;
}

// Model choices below are matched against the paper's stated methods
// (Sec 2.1) wherever possible, and confirmed against real OpenFOAM-8
// source (class TypeName() strings, not guessed from naming patterns --
// several submodel categories are inconsistent about
// PascalCase-vs-camelCase runtime names, so pattern-matching would have
// been wrong in at least one case here). Anything NOT directly stated
// by the paper is flagged explicitly.

solution
{
    active          true;
    coupled         true;
    transient       yes;
    cellValueSourceCorrection on;
    maxCo           0.3;

    sourceTerms
    {
        schemes
        {
            rho             explicit 1;
            U               explicit 1;
            Yi              explicit 1;
            h               explicit 1;
        }
    }

    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        thermo:mu       cell;
        T               cell;
        Cp              cell;
        kappa           cell;
        p               cell;
    }

    integrationSchemes
    {
        U               Euler;
        T               analytical;
    }
}

constantProperties
{
    // Paper Sec 2.2: droplets injected at 300 K.
    T0              300;

    // Placeholders -- reset internally from liquid properties (NXC7H16,
    // real n-heptane data via thermophysicalProperties/liquids ->
    // "type C7H16") at T0 once construction runs. Not used as the
    // actual simulated value.
    rho0            680;
    Cp0             2240;

    constantVolume  false;
}

subModels
{
    particleForces
    {
        // Paper: "sphere drag model", Cd from Liu/Mather/Reitz (1993) --
        // matches OpenFOAM's sphereDrag submodel directly, no judgment
        // call needed here.
        sphereDrag;
    }

    injectionModels
    {
        model1
        {
            // Transverse liquid jet injected from a wall patch, not a
            // free-space cone nozzle -- patchInjection is the correct
            // model class for this, confirmed via TypeName("patchInjection")
            // in OpenFOAM-8 source. This differs from the aachenBomb
            // reference case (which uses coneInjection) -- don't copy its
            // key names, they don't apply to this model.
            type            patchInjection;
            patchName       jet;

            // Continuous jet for now -- this is the step-1 goal
            // (validate continuous baseline before touching pulsing).
            SOI             0;
            duration        1e-3;     // matches controlDict endTime

            // U0: paper's u_jet for J=1.0, C7H16 = 60.83 m/s (Sec 3),
            // normal to the wall (transverse jet, +y into the flow).
            U0              (0 60.83 0);

            // massTotal: NOT given directly by the paper -- computed
            // here as rho_liquid * u_jet * (patch cross-section area) *
            // duration. Patch area uses the ACTUAL cut patch (0.4mm wide
            // x 2mm domain depth = 8e-7 m^2), not the nominal 0.5mm
            // spec, since that's what's physically being injected in
            // this discretized case -- see open_wedge/README.md note on
            // the jet patch width discrepancy.
            //   680 kg/m3 * 60.83 m/s * 8e-7 m2 * 1e-3 s = 3.31e-5 kg
            // TEMP DIAGNOSTIC: cut 10x from 3.31e-5 to isolate whether the
            // explicit spray source term (concentrated on a 2-face patch)
            // is causing the T/p blowup seen in the crashed run. Revert to
            // 3.31e-5 once confirmed/ruled out -- this is NOT a paper-
            // matched value.
            massTotal       3.31e-6;
            parcelBasisType mass;

            // NOT stated by the paper. Paper gives total parcel COUNT
            // (5e4-1e5 parcels, each representing 10 real droplets) over
            // the run, not a rate. Back-calculated: mid-range 7.5e4
            // total / 1e-3 s duration = 7.5e7/s. Sanity-check this
            // against actual parcel counts once you can run and log --
            // if it's producing wildly more or fewer parcels than the
            // paper's stated range by end of run, adjust.
            // TEMP DIAGNOSTIC: cut 10x alongside massTotal, same reason.
            parcelsPerSecond 7.5e6;

            flowRateProfile constant 1;

            sizeDistribution
            {
                // Paper Sec 2.2: "Rosin-Rammler (R-R) distribution
                // model is employed to substitute the primary
                // atomization process... average droplet diameter set
                // to 10 μm." Mean is given; spread exponent n and
                // min/max bounds are NOT given by the paper. n=3 and
                // the min/max below are placeholder assumptions
                // (n=3 is a common R-R value for sprays, also what
                // OpenFOAM's own aachenBomb tutorial uses) -- treat as
                // a tunable, not a paper-sourced value.
                type            RosinRammler;

                RosinRammlerDistribution
                {
                    minValue        1e-6;
                    maxValue        3e-5;
                    d               1e-5;
                    n               3;
                }
            }
        }
    }

    dispersionModel none;
    // Paper doesn't mention turbulent dispersion of droplets, and
    // momentumTransport is laminar here anyway (no turbulent kinetic
    // energy field to disperse against) -- "none" is the consistent
    // choice, not a corner cut.

    patchInteractionModel standardWallInteraction;
    // NOT discussed by the paper -- it describes the Eulerian wall as
    // slip-reflecting but never states Lagrangian droplet-wall
    // behavior. standardWallInteraction/rebound is the generic safe
    // default; flag if droplet behavior near lowerWall looks wrong.

    heatTransferModel RanzMarshall;
    // Paper Sec 2.1, Eqn for Nu: "Nu = 2.0 + 0.6 Re^0.5 Pr^(1/3)
    // (Ranz-Marshall model)" -- direct, unambiguous match.

    compositionModel singlePhaseMixture;

    phaseChangeModel liquidEvaporation;
    // Paper Sec 2.1 describes the Abramzon-Sirignano quasi-steady
    // model (Sh = 2.0 + 0.6 Re^0.5 Sc^(1/3), Raoult's law, B_M mass
    // transfer number, ln(1+B_M) evaporation rate). This matches
    // OpenFOAM's "LiquidEvaporation" class (quasi-steady film model),
    // NOT "LiquidEvaporationBoil" (which adds boiling-point behavior
    // the paper doesn't describe). This is a judgment call based on
    // matching the described physics, not a name I could just read off
    // the paper -- worth double-checking once you can inspect
    // LiquidEvaporation.C's actual Sherwood-number correlation against
    // the paper's stated one.

    surfaceFilmModel none;

    atomizationModel none;
    // Paper explicitly substitutes primary atomization with the R-R
    // distribution at injection -- "none" (NoAtomization) is the
    // textually correct choice, confirmed via
    // TypeName("none") in OpenFOAM-8 source.

    breakupModel    PilchErdman;
    // Paper Sec 2.1: "the Pilch-Erdman model is utilized" -- direct,
    // unambiguous match, exact class name.

    stochasticCollisionModel none;

    radiation       off;
    // Not discussed by the paper -- reasonable default for this scope.

    standardWallInteractionCoeffs
    {
        type            rebound;
    }

    RanzMarshallCoeffs
    {
        BirdCorrection  true;
    }

    singlePhaseMixtureCoeffs
    {
        phases
        (
            liquid
            {
                NXC7H16         1;
            }
        );
    }

    liquidEvaporationCoeffs
    {
        enthalpyTransfer enthalpyDifference;
        activeLiquids    ( NXC7H16 );
    }

    PilchErdmanCoeffs
    {
        // B1/B2 are MANDATORY -- PilchErdman.C does a bare .lookup()
        // with no lookupOrDefault fallback, despite the class also
        // having these as C++ default member values (0.375/0.2274)
        // that never actually get used unless the dict provides them
        // explicitly. Values below ARE those same defaults -- the
        // published Pilch & Erdman (1987) correlation constants, not a
        // guess or placeholder.
        B1              0.375;
        B2              0.2274;
    }
}

cloudFunctions
{}
