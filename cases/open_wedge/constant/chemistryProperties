FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}

chemistryType
{
    solver          ode;
}

chemistry       on;

initialChemicalTimeStep 1e-9;
// Tighter than the aachenBomb reference (1e-7) because your
// controlDict deltaT is already 1e-9 for the gas-phase CFL constraint;
// no point letting chemistry substep looser than the flow solver step.

odeCoeffs
{
    solver          seulex;
    eps             0.05;
}

// constant/reactions does not exist yet -- generated by chemkinToFoam
// from the actual 44-species/112-reaction mechanism (Liu, Hewson, Chen
// & Pitsch 2004), which you don't have sourced yet. See
// thermophysicalProperties for the matching #include and the
// chemkinToFoam command.
#include "reactions"
