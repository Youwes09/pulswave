FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverTypeProperties;
}

// MUST_READ per createFields.H -- case will not run without this file
// existing, regardless of content correctness. solverType selects which
// of detonationFoam_dev.C's branches runs (Euler / NS_Sutherland /
// NS_mixtureAverage / NSSpray_Sutherland); NSSpray_Sutherland is the
// two-phase spray solve path that actually uses basicSprayCloud, which
// is what this case needs.
solverType          NSSpray_Sutherland;

// Leading-shock-position exit criterion (see detonationFoam_dev.C: the
// run auto-exits once the shock reaches this x-position). Set past your
// domain's outflow (0.25 m) so it doesn't cut the run short before the
// jet-induced ODW has a chance to develop -- effectively disabled by
// setting it beyond the domain.
SW_position_limit  1.0;
