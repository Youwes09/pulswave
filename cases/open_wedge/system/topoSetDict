FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// Selects the lowerWall faces under the jet injector: x = 0.05 m,
// diameter 0.5 mm (per docs/case-spec-open-wedge.md). At 0.2 mm cells
// this is ~2.5 cells wide -- under-resolved for the injection BC.
// Acceptable for a first smoke-test run; refine locally before trusting
// any result near a J threshold. See README note.

actions
(
    {
        name    jetFaces;
        type    faceSet;
        action  new;
        source  boxToFace;
        sourceInfo
        {
            box     (0.04975 -1e-6 -1) (0.05025 1e-6 1);
        }
    }
);
