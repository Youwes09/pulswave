FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Geometry per docs/case-spec-open-wedge.md (Wang/Hu/Zhang 2025/2026,
// arXiv:2506.15247). Domain length 0.25 m, height 0.1 m.
//
// Domain is a flat rectangle in the wedge-attached reference frame: the
// wedge surface is the horizontal lowerWall, and the 27 deg wedge
// incidence is represented by rotating the inflow velocity vector
// rather than sloping the mesh. This is the standard convention in
// wedge-induced ODW CFD (not specific to this solver): the flow is
// quasi-self-similar in the wedge-attached frame, a rotated rectangular
// mesh is trivial and perfectly orthogonal, and the same solver's own
// author group (Sun et al., cited in detonationFoam's applications list)
// sweeps "wedge angle" as a cheap inflow-direction parameter across
// papers rather than remeshing a sloped geometry each time. Set the
// inflow velocity direction in 0/U to (cos(27deg), -sin(27deg), 0) *
// |U| (or equivalent, angled into the wedge) to represent the incidence.

convertToMeters 1;

vertices
(
    (0     0    -0.001)  // 0
    (0.25  0    -0.001)  // 1
    (0.25  0.1  -0.001)  // 2
    (0     0.1  -0.001)  // 3

    (0     0     0.001)  // 4
    (0.25  0     0.001)  // 5
    (0.25  0.1   0.001)  // 6
    (0     0.1   0.001)  // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (1250 500 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inflow
    {
        type patch;
        faces ((0 3 7 4));
    }
    outflow
    {
        type patch;
        faces ((1 2 6 5));
    }
    lowerWall
    {
        type wall;
        faces ((0 1 5 4));
    }
    upperBoundary
    {
        type patch;
        faces ((3 2 6 7));
    }
    frontAndBack
    {
        type empty;
        faces ((0 3 2 1) (4 7 6 5));
    }
);

mergePatchPairs
(
);
