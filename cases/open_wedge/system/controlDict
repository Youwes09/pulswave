FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     detonationFoam_V3.1;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         1e-3;

deltaT          1e-9;

writeControl    adjustableRunTime;
writeInterval   1e-5;

purgeWrite      0;

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;
maxCo           0.3;
