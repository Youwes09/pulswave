(
    inflow
    {
        type patch;
        faces ((0 3 9 6));
    }
    outflow
    {
        type patch;
        faces ((2 5 11 8));
    }
    lowerWall
    {
        type wall;
        faces ((0 1 7 6) (1 2 8 7));
    }
    upperWall
    {
        type wall;
        faces ((3 4 10 9) (4 5 11 10));
    }
    frontAndBack
    {
        type empty;
        faces ((0 3 4 1) (6 9 10 7) (1 4 5 2) (7 10 11 8));
    }
);

