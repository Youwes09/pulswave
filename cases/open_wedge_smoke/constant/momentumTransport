FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}

// Paper (2506.15247, Sec 2.2) explicitly neglects the boundary layer
// ("given the thin boundary layer resulting from the high Reynolds
// number, its effect is neglected") and never mentions a turbulence
// model. laminar is the faithful choice -- do NOT default to RAS
// kEpsilon (that's what the stock aachenBomb tutorial uses, but it's
// not what this paper does).
simulationType  laminar;
