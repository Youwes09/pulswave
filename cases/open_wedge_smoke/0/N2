FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      N2;
}

dimensions          [0 0 0 0 0 0 0];
internalField       uniform 0.752;

boundaryField
{
    inflow       { type fixedValue; value uniform 0.752; }
    outflow      { type zeroGradient; }
    upperBoundary{ type zeroGradient; }
    lowerWall    { type zeroGradient; }
    jet          { type zeroGradient; }
    frontAndBack { type empty; }
}
