FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 2.855e4;

boundaryField
{
    inflow
    {
        type            fixedValue;
        value           uniform 2.855e4;
    }
    outflow
    {
        // supersonic outflow per paper Sec 2.2
        type            zeroGradient;
    }
    upperBoundary
    {
        type            zeroGradient;
    }
    lowerWall
    {
        type            zeroGradient;
    }
    jet
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
