FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      NXC7H16;
}

// STAND-IN composition for pipeline smoke-test only -- NOT the paper's
// actual inflow mixture (paper specifies droplet-laden air with fuel
// vapor generated by evaporation, not a premixed gas-phase C7H16 mass
// fraction at the inlet). Values below are just a plausible lean
// fuel-air split summing to 1.0 with the toy 5-species mechanism, so
// the solver has something physically sane to advance -- revisit
// entirely once you're past pipeline-testing.
dimensions          [0 0 0 0 0 0 0];
internalField       uniform 0.02;

boundaryField
{
    inflow       { type fixedValue; value uniform 0.02; }
    outflow      { type zeroGradient; }
    upperBoundary{ type zeroGradient; }
    lowerWall    { type zeroGradient; }
    jet          { type zeroGradient; }
    frontAndBack { type empty; }
}
